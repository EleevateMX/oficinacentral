# Dominio que apunta a la IP del VPS (registro A en tu DNS)
DOMAIN=oficina.tudominio.com

# IP pública del VPS (la que te da el proveedor)
PUBLIC_IP=203.0.113.10

# Nombre de la oficina y tema inicial (luego se cambian en Preferencias > Marca de la oficina)
# Temas: nuvora, gtahub, custom
OFFICE_NAME=HUB
OFFICE_THEME=gtahub

# Primer administrador (solo se crea si la base de datos está vacía)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contraseña
ADMIN_NAME=Administrador
ADMIN_EMAIL=

# Secreto compartido entre la app y el servidor TURN.
# Genéralo con:  openssl rand -hex 32
TURN_SECRET=

# Cuántos respaldos diarios conservar en el servidor
BACKUP_KEEP=14

# ---- Respaldos fuera del servidor (opcional, muy recomendado) ----
# Cualquier almacenamiento compatible con S3: Cloudflare R2 (recomendado), AWS S3, Backblaze B2, MinIO.
# Se activa solo si están ENDPOINT, BUCKET, ACCESS_KEY y SECRET_KEY. Cada respaldo diario se comprime
# y se sube; los adjuntos del chat se suben una sola vez cada uno. Pasos en DEPLOY.md.
# R2:  https://<accountid>.r2.cloudflarestorage.com      B2: https://s3.<region>.backblazeb2.com
# S3:  https://s3.<region>.amazonaws.com (y BACKUP_S3_REGION=<region>)
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# "auto" para R2; en S3/B2 la región del bucket (p. ej. us-east-1)
BACKUP_S3_REGION=auto
# Carpeta dentro del bucket
BACKUP_S3_PREFIX=nuvora/
# Cuántos respaldos de la base conservar en el bucket (los adjuntos no se borran)
BACKUP_S3_KEEP=30

# ---- LiveKit (opcional, recomendado con varias transmisiones a la vez) ----
# Enciéndelo con: docker compose --profile livekit up -d --build
# LIVEKIT_URL usa tu mismo dominio (Caddy pasa /rtc a LiveKit).
# Genera la llave y el secreto con:  openssl rand -hex 8   y   openssl rand -hex 32
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Avisos de errores y caídas ----
# Webhook de un canal de Discord (Ajustes del canal → Integraciones → Webhooks) o de Slack.
# Avisa cuando la app arranca, se apaga, falla o hay errores repetidos en el navegador.
ALERT_WEBHOOK_URL=

# ---- Entrar con Discord (opcional) ----
# Crea una app en https://discord.com/developers/applications → OAuth2.
# Redirect: https://TU-DOMINIO/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# URL pública de la oficina (si no, se toma del navegador)
PUBLIC_URL=

# ---- Notificaciones push (app instalable) ----
# Opcional: si se dejan vacías, la app genera sus llaves VAPID la primera vez y las guarda en la base de datos.
# Para fijarlas tú:  npx web-push generate-vapid-keys
# VAPID_SUBJECT es un contacto para los servicios push (mailto: o https://). Apple lo exige válido.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tudominio.com
