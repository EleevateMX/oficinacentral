{
  "name": "nuvora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nuvora: oficina virtual privada con mapa 2D, audio y video por cercanía, chat y calendario. Acceso solo por invitación.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server --watch-path=shared server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "create-admin": "node server/cli/create-admin.js",
    "backup": "node server/cli/backup.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "npm run build && node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "reset-2fa": "node server/cli/reset-2fa.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "livekit-client": "^2.23.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "vite": "^8.3.5"
  }
}
